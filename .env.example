# Discord Bot Token (aus dem Discord Developer Portal)
DISCORD_TOKEN=HIER_DEINEN_BOT_TOKEN_EINFUEGEN

# Optional: Eigener SoundCloud Client-ID.
# Wenn leer gelassen, wird die Standard-Client-ID von soundcloud-downloader verwendet.
# Falls das Streaming nicht funktioniert, hier eine eigene Client-ID eintragen.
SC_CLIENT_ID=
